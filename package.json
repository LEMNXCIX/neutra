{
  "name": "neutra",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format:check": "turbo run format:check",
    "check:arch": "turbo run check:arch",
    "doctor:api": "bun run --cwd apps/api doctor",
    "commons:check": "turbo run commons:check",
    "verify:production": "bun run --cwd apps/api verify:production"
  },
  "devDependencies": {
    "turbo": "^2.10.12"
  }
}
