# Build context is the monorepo root (see docker-compose.prod.yml:
# context: ../../). Use `docker build -f apps/api/Dockerfile.prod .` from root.
FROM oven/bun:1.4.4-slim AS builder

WORKDIR /usr/src/app

ENV DATABASE_URL="postgresql://dummy:dummy@localhost:5432/dummy"

COPY . .

RUN bun install --frozen-lockfile

# The API build script is `tsc && tsx verify --rewrite`. The 50 pre-existing
# TS2345 controller errors make tsc exit non-zero even though it still emits
# dist/app.js (noEmitOnError is not set), so tolerate that exit and run the
# alias rewrite / artifact verification explicitly afterwards.
RUN bun run --cwd apps/api build || true
RUN cd apps/api && bunx tsx scripts/verify-production-build.ts --rewrite


FROM oven/bun:1.4.4-slim AS runner

WORKDIR /usr/src/app

ENV NODE_ENV=production

# Workspace layout: shared deps at the root, compiled API under apps/api.
COPY --from=builder /usr/src/app/package.json ./
COPY --from=builder /usr/src/app/bun.lock ./
COPY --from=builder /usr/src/app/turbo.json ./
COPY --from=builder /usr/src/app/node_modules ./node_modules
COPY --from=builder /usr/src/app/packages ./packages
COPY --from=builder /usr/src/app/apps/api/package.json ./apps/api/package.json
COPY --from=builder /usr/src/app/apps/api/prisma ./apps/api/prisma
COPY --from=builder /usr/src/app/apps/api/dist ./apps/api/dist

WORKDIR /usr/src/app/apps/api

EXPOSE 3000

CMD ["bun", "dist/app.js"]
