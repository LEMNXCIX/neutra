# Build context is the monorepo root (see docker-compose.prod.yml:
# context: ../../). Use `docker build -f apps/api/Dockerfile.prod .` from root.
#
# D3/D5: Node 22 is the runtime; Bun is only the package manager / install tool
# used in the builder stages. The final image runs `node dist/app.js`.

FROM oven/bun:1.4.4-slim AS builder

WORKDIR /usr/src/app

# The api workspace postinstall runs `prisma generate`, which needs a URL even
# though no database is contacted at build time.
ENV DATABASE_URL="postgresql://dummy:dummy@localhost:5432/dummy"

# The root .dockerignore excludes node_modules and dist from the context, so
# everything below is built fresh inside the image.
COPY . .

RUN bun install --frozen-lockfile

# @neutra/commons is a workspace package whose exports point at dist/. With
# dist excluded from the context it must be compiled here before the API build
# (and before the API's runtime resolves it).
RUN bun run --cwd packages/commons build

# The API build script is `tsc && tsx verify --rewrite`. The 50 pre-existing
# TS2345 controller errors make tsc exit non-zero even though it still emits
# dist/app.js (noEmitOnError is not set), so tolerate that exit and run the
# alias rewrite / artifact verification explicitly afterwards.
RUN bun run --cwd apps/api build || true
RUN cd apps/api && bunx tsx scripts/verify-production-build.ts --rewrite

# Prisma's generated client lives inside node_modules (under the bun isolated
# store). Preserve it here; the production-only install below uses --ignore-scripts
# and needs the client restored so the runtime can instantiate PrismaClient
# without a devDependency on the prisma CLI.
RUN mkdir -p /tmp/prisma-generated && \
    nm_dir="$(dirname "$(dirname "$(readlink -f apps/api/node_modules/@prisma/client)")")" && \
    cp -a "${nm_dir}/.prisma" /tmp/prisma-generated/.prisma


# I4: a FRESH production-only dependency tree. Installing --production over the
# full builder node_modules does not prune dev packages, so use a clean stage.
FROM oven/bun:1.4.4-slim AS prod-deps

WORKDIR /usr/src/app

ENV DATABASE_URL="postgresql://dummy:dummy@localhost:5432/dummy"

# Only the manifests are needed to resolve the workspace graph from bun.lock.
# apps/cms/package.json is copied so bun does not report a skipped workspace.
COPY package.json bun.lock ./
COPY apps/api/package.json ./apps/api/package.json
COPY packages/commons/package.json ./packages/commons/package.json
COPY apps/cms/package.json ./apps/cms/package.json

RUN bun install --production --frozen-lockfile --ignore-scripts

# Restore the generated Prisma client into whatever (hash-suffixed) @prisma/client
# directory this production install resolved.
COPY --from=builder /tmp/prisma-generated/.prisma /tmp/prisma-generated/.prisma
RUN nm_dir="$(dirname "$(dirname "$(readlink -f apps/api/node_modules/@prisma/client)")")" && \
    cp -a /tmp/prisma-generated/.prisma "${nm_dir}/.prisma"


FROM node:22-slim AS runner

WORKDIR /usr/src/app

ENV NODE_ENV=production

# Workspace layout: production-only deps at the root and under apps/api,
# compiled API under apps/api/dist and the built @neutra/commons under packages.
COPY --from=builder /usr/src/app/package.json ./
COPY --from=builder /usr/src/app/bun.lock ./
COPY --from=builder /usr/src/app/turbo.json ./
COPY --from=prod-deps /usr/src/app/node_modules ./node_modules
COPY --from=prod-deps /usr/src/app/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder /usr/src/app/packages ./packages
COPY --from=builder /usr/src/app/apps/api/package.json ./apps/api/package.json
COPY --from=builder /usr/src/app/apps/api/prisma ./apps/api/prisma
COPY --from=builder /usr/src/app/apps/api/dist ./apps/api/dist

WORKDIR /usr/src/app/apps/api

EXPOSE 3000

CMD ["node", "dist/app.js"]
