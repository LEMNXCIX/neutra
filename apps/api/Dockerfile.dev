# Build context is the monorepo root (see docker-compose*.yml: context: ../../).
# Copying the whole workspace keeps the @neutra/commons dependency resolvable
# and lets the api postinstall run prisma generate against apps/api/prisma.
FROM oven/bun:1.4.4-slim

WORKDIR /usr/src/app

ENV DATABASE_URL="postgresql://dummy:dummy@localhost:5432/dummy"

COPY . .

RUN bun install --frozen-lockfile

EXPOSE 3000

CMD ["bun", "run", "--cwd", "apps/api", "dev"]
