# Build context is the monorepo root (see docker-compose*.yml: context: ../../).
# Copying the whole workspace keeps the @neutra/commons dependency resolvable
# and lets the api postinstall run prisma generate against apps/api/prisma.
#
# D3/D5: Node 22 is the runtime; Bun is only the package manager / script
# runner. The bun binary is copied from an image so the dev container (and the
# debug compose command, which invokes `bun ...`) keeps working unchanged.
FROM oven/bun:1.4.4-slim AS bun

FROM node:22-slim

WORKDIR /usr/src/app

ENV DATABASE_URL="postgresql://dummy:dummy@localhost:5432/dummy"

COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun

COPY . .

RUN bun install --frozen-lockfile

EXPOSE 3000

CMD ["bun", "run", "--cwd", "apps/api", "dev"]
